    {
      "parameters": {
        "jsCode": "// Pull CSV from the HTTP Request node (Azure Blob)\nconst csv = $('HTTP Request').item.json.data;\n\nconst rows = csv.trim().split('\\n').map(r => r.split(','));\nconst headers = rows[0];\nconst data = rows.slice(1);\nconst col = name => headers.indexOf(name);\nconst total = data.length;\n\nlet nullCustomer = 0, nullChurn = 0, badRevenue = 0;\n\nfor (const row of data) {\n  if (!row[col('customer_id')].trim()) nullCustomer++;\n  if (!row[col('churn_label')].trim()) nullChurn++;\n  const rev = parseFloat(row[col('revenue')]);\n  if (!isNaN(rev) && rev < -1000) badRevenue++;\n}\n\nreturn [{\n  json: {\n    total_rows: total,\n    null_customer_id: nullCustomer,\n    null_churn_label: nullChurn,\n    bad_revenue: badRevenue,\n    customer_id_pct: Math.round((nullCustomer/total)*100),\n    churn_label_pct: Math.round((nullChurn/total)*100),\n    status: (nullCustomer > 0 || nullChurn > 0 || badRevenue > 0) ? 'BLOCKED' : 'OK'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
